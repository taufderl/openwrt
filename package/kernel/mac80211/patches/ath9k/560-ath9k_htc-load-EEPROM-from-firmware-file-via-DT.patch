From: Tim <tadl-git@taufderl.de>
Subject: [PATCH] wifi: ath9k_htc: support EEPROM data from a firmware file

Some embedded boards solder down an AR9271 USB adapter without populating
its EEPROM and ship the calibration data as a file instead. One example is
the Fingbox (Allwinner H3), where the driver currently fails with
"Invalid EEPROM magic (0x0000)".

Mirror what ath9k already offers for PCI devices: if the USB device is
described in DT (usb-device binding) and carries "qca,no-eeprom", request
the calibration data with request_firmware() and read the EEPROM through
the generic nvram path instead of the USB register path. The file name is
taken from "firmware-name", falling back to ath9k-eeprom-usb-<dev>.bin.

Also honour a MAC address from DT (e.g. an NVMEM cell), as ath9k does.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Tim <tadl-git@taufderl.de>
---
--- a/drivers/net/wireless/ath/ath9k/eeprom_4k.c
+++ b/drivers/net/wireless/ath/ath9k/eeprom_4k.c
@@ -66,7 +66,7 @@ static bool ath9k_hw_4k_fill_eeprom(stru
 		ath_dbg(common, EEPROM, "Reading from EEPROM, not flash\n");
 	}
 
-	if (common->bus_ops->ath_bus_type == ATH_USB)
+	if (common->bus_ops->ath_bus_type == ATH_USB && !ath9k_hw_use_flash(ah))
 		return __ath9k_hw_usb_4k_fill_eeprom(ah);
 	else
 		return __ath9k_hw_4k_fill_eeprom(ah);
--- a/drivers/net/wireless/ath/ath9k/eeprom_9287.c
+++ b/drivers/net/wireless/ath/ath9k/eeprom_9287.c
@@ -69,7 +69,7 @@ static bool ath9k_hw_ar9287_fill_eeprom(
 		ath_dbg(common, EEPROM, "Reading from EEPROM, not flash\n");
 	}
 
-	if (common->bus_ops->ath_bus_type == ATH_USB)
+	if (common->bus_ops->ath_bus_type == ATH_USB && !ath9k_hw_use_flash(ah))
 		return __ath9k_hw_usb_ar9287_fill_eeprom(ah);
 	else
 		return __ath9k_hw_ar9287_fill_eeprom(ah);
--- a/drivers/net/wireless/ath/ath9k/eeprom_def.c
+++ b/drivers/net/wireless/ath/ath9k/eeprom_def.c
@@ -125,7 +125,7 @@ static bool ath9k_hw_def_fill_eeprom(str
 		ath_dbg(common, EEPROM, "Reading from EEPROM, not flash\n");
 	}
 
-	if (common->bus_ops->ath_bus_type == ATH_USB)
+	if (common->bus_ops->ath_bus_type == ATH_USB && !ath9k_hw_use_flash(ah))
 		return __ath9k_hw_usb_def_fill_eeprom(ah);
 	else
 		return __ath9k_hw_def_fill_eeprom(ah);
--- a/drivers/net/wireless/ath/ath9k/htc_drv_init.c
+++ b/drivers/net/wireless/ath/ath9k/htc_drv_init.c
@@ -16,6 +16,9 @@
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
+#include <linux/of.h>
+#include <linux/of_net.h>
+
 #include "htc.h"
 
 MODULE_AUTHOR("Atheros Communications");
@@ -100,6 +103,7 @@ static int ath9k_htc_wait_for_target(str
 static void ath9k_deinit_priv(struct ath9k_htc_priv *priv)
 {
 	ath9k_hw_deinit(priv->ah);
+	release_firmware(priv->ah->eeprom_blob);
 	kfree(priv->ah);
 	priv->ah = NULL;
 }
@@ -603,10 +607,58 @@ static void ath9k_init_misc(struct ath9k
 	priv->spec_priv.spec_config.fft_period = 0x02;
 }
 
+/*
+ * Embedded boards may solder down a USB adapter without an EEPROM and
+ * ship the calibration data in a file instead. Such boards describe the
+ * USB device in DT (usb-device binding) and set "qca,no-eeprom", like the
+ * ath9k PCI binding does.
+ */
+static struct device_node *ath9k_htc_of_node(struct device *dev)
+{
+	/* fall back to the USB device node if the interface has none */
+	if (!dev->of_node && dev->parent)
+		return dev->parent->of_node;
+
+	return dev->of_node;
+}
+
+static int ath9k_htc_of_init(struct ath9k_htc_priv *priv)
+{
+	struct device_node *np = ath9k_htc_of_node(priv->dev);
+	struct ath_hw *ah = priv->ah;
+	char eeprom_name[64];
+	const char *name;
+	int ret;
+
+	if (!np || !of_device_is_available(np) ||
+	    !of_property_read_bool(np, "qca,no-eeprom"))
+		return 0;
+
+	if (of_property_read_string(np, "firmware-name", &name)) {
+		/* ath9k-eeprom-usb-<id>.bin */
+		scnprintf(eeprom_name, sizeof(eeprom_name),
+			  "ath9k-eeprom-usb-%s.bin", dev_name(priv->dev));
+		name = eeprom_name;
+	}
+
+	ret = request_firmware(&ah->eeprom_blob, name, priv->dev);
+	if (ret) {
+		ath_err(ath9k_hw_common(ah),
+			"Unable to load EEPROM file %s\n", name);
+		return ret;
+	}
+
+	ah->ah_flags &= ~AH_USE_EEPROM;
+	ah->ah_flags |= AH_NO_EEP_SWAP;
+
+	return 0;
+}
+
 static int ath9k_init_priv(struct ath9k_htc_priv *priv,
 			   u16 devid, char *product,
 			   u32 drv_info)
 {
+	struct device_node *np = ath9k_htc_of_node(priv->dev);
 	struct ath_hw *ah = NULL;
 	struct ath_common *common;
 	int i, ret = 0, csz = 0;
@@ -660,6 +712,10 @@ static int ath9k_init_priv(struct ath9k_
 	ath_read_cachesize(common, &csz);
 	common->cachelsz = csz << 2; /* convert to bytes */
 
+	ret = ath9k_htc_of_init(priv);
+	if (ret)
+		goto err_hw;
+
 	ret = ath9k_hw_init(ah);
 	if (ret) {
 		ath_err(common,
@@ -668,6 +724,10 @@ static int ath9k_init_priv(struct ath9k_
 		goto err_hw;
 	}
 
+	/* a MAC address from DT (e.g. an NVMEM cell) overrides the EEPROM */
+	if (np)
+		of_get_mac_address(np, common->macaddr);
+
 	ret = ath9k_init_queues(priv);
 	if (ret)
 		goto err_queues;
@@ -686,7 +746,7 @@ static int ath9k_init_priv(struct ath9k_
 err_queues:
 	ath9k_hw_deinit(ah);
 err_hw:
-
+	release_firmware(ah->eeprom_blob);
 	kfree(ah);
 	priv->ah = NULL;
 
